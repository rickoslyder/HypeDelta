# Database
DATABASE_URL=postgresql://aiintel:***@localhost:5432/ai_intel
POSTGRES_PASSWORD=

# Immutable production images (required by deploy/docker-compose.production.yml)
WEB_IMAGE=
WORKER_IMAGE=

# Twitter API (https://twitterapi.io)
TWITTER_API_KEY=

# Worker model routing (required). Provider URLs and model IDs are pinned in code.
DEEPSEEK_API_KEY=
KIMI_CODING_API_KEY=

# Embedding Provider: ollama | openai | voyage
EMBEDDING_PROVIDER=ollama

# Web admin auth (both required; never reuse one value for the other)
# ADMIN_PASSWORD: login credential only
# ADMIN_SESSION_SECRET: independent HMAC key for admin session cookies
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Scheduler processing selection (optional; safe defaults applied)
# PROCESS_LOOKBACK_DAYS: unprocessed content window (default 30, max 365)
# PROCESS_BATCH_LIMIT: max items per processing tick (default 50, max 500)
# PROCESS_LOOKBACK_DAYS=30
# PROCESS_BATCH_LIMIT=50

# ---------------------------------------------------------------------------
# Legacy / disconnected — not used by the production worker.
# Code pins DeepSeek + Kimi Coding lanes; do not export these as active env.
# CLAUDE_CODE_OAUTH_TOKEN=
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/v1
# ANTHROPIC_API_KEY=
# ---------------------------------------------------------------------------
